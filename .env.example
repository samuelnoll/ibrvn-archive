TZ=America/Sao_Paulo

HOMELAB_NETWORK=homelab

ARCHIVE_API_HOST=0.0.0.0
ARCHIVE_API_PORT=8000

# Phase 2 default: use PostgreSQL from homelab-infra.
ARCHIVE_DATABASE_BACKEND=postgres
ARCHIVE_DATABASE_HOST=postgres
ARCHIVE_DATABASE_PORT=5432
ARCHIVE_DATABASE_NAME=app
ARCHIVE_DATABASE_USER=app
ARCHIVE_DATABASE_PASSWORD=change-me

# Optional full DSN. Leave empty when using the fields above.
ARCHIVE_DATABASE_URL=

# Keep the legacy SQLite file mounted for one-time backfill and rollback safety.
ARCHIVE_GOLD_DB_PATH=/app/data/gold/archive.db
ARCHIVE_LEGACY_SQLITE_PATH=/app/data/gold/archive.db
ARCHIVE_EXPORT_DIR=/app/data/exports
ARCHIVE_AUDIO_RAW_DIR=/app/data/audio/raw
ARCHIVE_AI_BASE_URL=http://homelab-ai-api:8100
ARCHIVE_AI_TIMEOUT_SECONDS=7200
ARCHIVE_EMAIL_SMTP_HOST=
ARCHIVE_EMAIL_SMTP_PORT=587
ARCHIVE_EMAIL_SMTP_USER=
ARCHIVE_EMAIL_SMTP_PASSWORD=
ARCHIVE_EMAIL_SMTP_USE_TLS=true
ARCHIVE_EMAIL_FROM=
ARCHIVE_EMAIL_TO=

# Host paths for bind mounts on Ubuntu.
ARCHIVE_DATA_HOST_PATH=/srv/homelab/volumes/ibrvn-archive/data
ARCHIVE_LOGS_HOST_PATH=/srv/homelab/volumes/ibrvn-archive/logs

# Required only by the pipeline runtime.
YOUTUBE_API_KEY=
