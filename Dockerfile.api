FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .

RUN mkdir -p /app/data/gold /app/logs/api

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main:app --host ${ARCHIVE_API_HOST:-0.0.0.0} --port ${ARCHIVE_API_PORT:-8000}"]
